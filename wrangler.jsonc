{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memefabriek",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/m/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: the first deploy creates this database by itself.
      "database_name": "memefabriek"
    }
  ],
  // The news desk: 07:00, 12:00, 17:00 and 21:00 Dutch summer time (cron runs in UTC).
  "triggers": { "crons": ["0 5,10,15,19 * * *"] },
  "vars": {
    "CLAUDE_MODEL": "claude-opus-5-5",
    "POSTS_PER_10_MIN": "6",
    "GENERATIONS_PER_HOUR": "15",
    "GENERATIONS_PER_DAY": "400",
    "REPORTS_TO_HIDE": "3",
    "NEWS_PER_RUN": "3"
  },
  "observability": { "enabled": true }
}
