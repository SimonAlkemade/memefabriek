{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memefabriek",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memefabriek",
      // Fill in after `npx wrangler d1 create memefabriek` (see README).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // The news desk: 07:00, 12:00, 17:00 and 21:00 Dutch summer time (cron runs in UTC).
  "triggers": { "crons": ["0 5,10,15,19 * * *"] },
  "vars": {
    "CLAUDE_MODEL": "claude-opus-5-5",
    "POSTS_PER_10_MIN": "6",
    "GENERATIONS_PER_HOUR": "15",
    "GENERATIONS_PER_DAY": "400",
    "REPORTS_TO_HIDE": "3",
    "NEWS_PER_RUN": "3"
  },
  "observability": { "enabled": true }
}
